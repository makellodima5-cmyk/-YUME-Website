{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yume-website",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "main": ".output/server/index.mjs",
  "triggers": {
    "crons": ["*/5 * * * *","37 7 * * *","41 19 * * *"]
  },
  "ratelimits": [
    {
      "name": "KODIK_RATE_LIMITER",
      "namespace_id": "202610271",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "MEDIA_RATE_LIMITER",
      "namespace_id": "202610272",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "no_bundle": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "d1_databases": [
    {
      "binding": "YUME_DB",
      "database_name": "yume_db",
      "database_id": "29aea579-e316-413f-922b-44c17b12f45a"
    }
  ]
}
