{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yume-website",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "main": ".output/server/index.mjs",
  "ratelimits": [
    {
      "name": "KODIK_RATE_LIMITER",
      "namespace_id": "202610271",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "MEDIA_RATE_LIMITER",
      "namespace_id": "202610272",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "CSP_REPORT_RATE_LIMITER",
      "namespace_id": "202610273",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "no_bundle": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.mjs",
        "**/*.js"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "YUME_DB",
      "database_name": "yumedb",
      "database_id": "c2f0f25d-e29b-47e2-ad11-b726f7a3e9a2",
      "migrations_dir": "migrations-clean"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "YUME_WEB_TASKS",
        "queue": "yume-web-tasks"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "YUME_SHIKIMORI_CACHE",
      "id": "598c5207a7054b3eb45e2efe8214f5d7"
    }
  ],
  "services": [
    {
      "binding": "YUME_CATALOG_READER",
      "service": "yume-catalog-reader"
    },
    {
      "binding": "YUME_CATALOG_COORDINATOR",
      "service": "yume-catalog-coordinator"
    }
  ]
}
