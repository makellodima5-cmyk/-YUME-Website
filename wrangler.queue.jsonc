{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yume-web-queue-consumer",
  "main": "src/queue-worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "YUME_DB",
      "database_name": "yumedb",
      "database_id": "c2f0f25d-e29b-47e2-ad11-b726f7a3e9a2",
      "migrations_dir": "migrations-clean"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "yume-web-tasks",
        "max_batch_size": 2,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "yume-web-tasks-dlq"
      }
    ]
  }
}
