{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yume-catalog-reader",
  "main": "src/workers/catalog-reader.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "R2_ACCOUNT_ID": "8a759ec4125475f60d793affe37779b7"
  },
  "r2_buckets": [
    {
      "binding": "CATALOG_BUCKET",
      "bucket_name": "yume-catalog"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "YUME_CATALOG_CACHE",
      "id": "598c5207a7054b3eb45e2efe8214f5d7"
    }
  ]
}
