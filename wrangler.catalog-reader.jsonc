{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yume-catalog-reader",
  "main": "src/workers/catalog-reader.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "R2_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
  }
}
